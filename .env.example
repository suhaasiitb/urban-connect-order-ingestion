# ==============================================================================
# PUBLIC FRONTEND ENVIRONMENT VARIABLES (Safe to bundle in Vite / GitHub Pages)
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Never place SUPABASE_SERVICE_ROLE_KEY or database passwords in any VITE_* variable!

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_APP_TIMEZONE=Asia/Kolkata

# ==============================================================================
# PRIVATE BACKEND SECRETS (Configure in Supabase Edge Function Secrets ONLY)
# ==============================================================================
# Do NOT put real values here. Set these via Supabase CLI:
#   supabase secrets set ALLOWED_ORIGINS="https://your-github-username.github.io,http://localhost:5173"
#
# Note: SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are
# automatically injected into Supabase Edge Functions at runtime.
# ALLOWED_ORIGINS=https://your-github-username.github.io,http://localhost:5173
